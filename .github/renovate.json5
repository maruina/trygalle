{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  // Top level because Renovate 44 rejects it inside a customManagers entry
  // (issue #14): semantic commits give the bump PR a `chore(deps):` title,
  // which semantic-release maps to a patch release.
  "semanticCommits": "enabled",
  // Prune go.sum on every go.mod bump instead of leaving stale checksums
  // behind (seen on the go-telegram v1.28.0 automerge).
  "postUpdateOptions": ["gomodTidy"],
  // Automerge behavior copied from maruina/go-infrabin's renovate.json.
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      // Automerge major updates when Build passes; accepted risk: an update
      // that breaks Build after merge forces a revert.
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "description": "Group all Go module dependency updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go module dependencies"
    },
    {
      "description": "Separate PR for Go version updates",
      "matchManagers": ["gomod", "dockerfile", "github-actions"],
      "matchPackageNames": ["go", "golang", "actions/setup-go"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "Go version"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Auto-update Docker digests",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      // The pi pin lives in four files with two different shapes. One regex
      // manager matches both, so a bump PR moves the Go constant, the CI
      // install line, the AGENTS.md install line, and the Dockerfile npm
      // literal together — and the full CI job then runs the live suite
      // against the new pin, which is the upgrade evidence gate (AGENTS.md).
      "managerFilePatterns": [
        "/^internal/harness/harness\\.go$/",
        "/^\\.github/workflows/ci\\.yml$/",
        "/^AGENTS\\.md$/",
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "PinnedPiVersion\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "@earendil-works/pi-coding-agent@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "@earendil-works/pi-coding-agent",
      "datasourceTemplate": "npm"
    }
  ]
}
